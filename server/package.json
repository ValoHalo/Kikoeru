{
  "name": "kikoeru-server",
  "version": "0.7.6",
  "private": true,
  "description": "A self-hosted media server for listening to your DLsite voice works.",
  "homepage": "https://github.com/ValoHalo/Kikoeru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValoHalo/Kikoeru.git"
  },
  "type": "commonjs",
  "keywords": [
    "kikoeru"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "kikoeru-express": "src/app.js"
  },
  "pkg": {
    "scripts": [
      "src/filesystem/scanner.js",
      "src/filesystem/updater.js",
      "src/**/*.js",
      "!src/public/**/*.js",
      "src/database/migrations/*",
      "src/database/knexfile.js",
      "src/database/storage.js"
    ],
    "assets": [
      "src/**/*",
      "node_modules/sqlite3/build/Release/node_sqlite3.node",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/@parcel/watcher-win32-x64/watcher.node",
      "node_modules/@parcel/watcher-win32-x64/package.json"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "config/*",
      "sqlite/*"
    ],
    "delay": "3000",
    "signal": "SIGKILL",
    "watch": [
      "src/**/*"
    ]
  },
  "scripts": {
    "start": "node --trace-warnings src/app.js",
    "dev": "node --trace-warnings src/app.js",
    "scan": "node --trace-warnings src/filesystem/scanner.js",
    "build": "npm run check",
    "check": "node scripts/check-syntax.js",
    "release:win": "node scripts/build-release.js",
    "test": "node --test test/unit/*.test.js"
  },
  "author": "Watanuki-Kimihiro",
  "contributors": [
    "umonaca <mw2010a@gmail.com>"
  ],
  "license": "GPL-3.0-only",
  "optionalDependencies": {
    "@parcel/watcher-win32-x64": "^2.5.6"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.6",
    "@umonaca/umzug": "^2.3.1",
    "axios": "1.18.1",
    "better-sqlite3": "^12.10.0",
    "bluebird": "^3.7.2",
    "body-parser": "1.20.6",
    "cheerio": "^1.0.0-rc.6",
    "compare-versions": "^3.6.0",
    "compression": "^1.7.4",
    "connect-history-api-fallback": "^1.6.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-jwt": "^6.0.0",
    "express-validator": "^6.10.1",
    "fluent-ffmpeg": "^2.1.3",
    "htmlparser2": "^4.1.0",
    "iconv-lite": "^0.6.3",
    "invariant": "^2.2.4",
    "jschardet": "^3.0.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^2.5.1",
    "knex-migrate": "^1.7.4",
    "limit-promise": "^1.0.6",
    "lodash": "^4.17.21",
    "lodash-es": "^4.18.1",
    "md5": "^2.3.0",
    "minimatch": "^3.0.4",
    "multer": "2.2.0",
    "mysql2": "^3.11.0",
    "natural-compare-lite": "^1.4.0",
    "natural-orderby": "^2.0.3",
    "recursive-readdir": "^2.2.2",
    "serve-index": "^1.9.1",
    "socket.io": "^2.4.1",
    "socketio-jwt-auth": "^0.2.1",
    "sqlite3": "^5.0.2",
    "string-random": "^0.1.3",
    "tunnel-agent": "^0.6.0",
    "url-join": "^4.0.1",
    "uuid": "11.1.1",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/bluebird": "^3.5.42",
    "@types/compression": "^1.8.1",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/express-jwt": "^6.0.4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/md5": "^2.3.6",
    "@types/minimatch": "^5.1.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/recursive-readdir": "^2.2.4",
    "@types/serve-index": "^1.9.4",
    "@types/socket.io": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@yao-pkg/pkg": "^6.21.0",
    "chai": "^4.3.4",
    "chai-string": "^1.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.4.0",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^17.6.0",
    "mocha": "^8.3.2",
    "nodemon": "^2.0.20",
    "shx": "^0.4.0",
    "typescript": "^5.3.3"
  }
}
